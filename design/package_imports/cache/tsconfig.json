{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowArbitraryExtensions": true,
		"rootDirs": ["..", "./svelte"],
		"paths": {
			"#lib": ["../src/lib/index.js"],
			"#lib/*": ["../src/lib/*", "./svelte/src/lib/*"]
		}
	},
	"include": ["../src", "../ambient.d.ts"]
}
