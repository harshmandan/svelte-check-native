#!/usr/bin/env bash
#
# Run a cargo command such that it cannot outlive the thing that started
# it, and cannot collide with another run.
#
# Why this exists
# ---------------
# Concurrent cargo invocations are this repo's most expensive failure
# mode: a `cargo test --workspace` that takes 29s on a quiet machine was
# measured at 574s with one competing release build. Nothing recompiled
# and no lock was contended — the test binaries were simply starved of
# cores. See CLAUDE.md, "One cargo at a time".
#
# The usual defences do not survive the case that actually causes it: an
# agent session that dies, is disconnected, or is killed mid-build. A
# shell trap does not run on SIGKILL. An editor hook does not run if the
# editor is gone. Whatever cleans up must therefore not depend on the
# previous run still being alive to do it.
#
# So cleanup is owned two ways:
#
#   1. While alive — the cargo child runs in its own process group, and
#      traps on EXIT/INT/TERM/HUP kill that whole group. Covers ctrl-c,
#      a closed terminal, and an ordinary agent stop.
#   2. After death — a dead session's processes reparent to launchd, so
#      "ppid 1 + working directory inside this repo" identifies a true
#      orphan with certainty: a LIVE agent's build always has a live
#      parent shell. Every ct start sweeps and kills exactly those,
#      then discards any lock whose recorded owner is gone. This is the
#      path that survives SIGKILL, a lost connection, or a hard reboot
#      of the agent — and it can never kill another agent's active run.
#
# A cargo started by hand in a terminal doesn't take this lock, so it is
# detected instead: before spawning, ct looks for any live cargo process
# whose working directory is inside this repo and waits for it (or
# refuses, without CT_WAIT) rather than piling on. Nothing to install,
# nothing on PATH.
#
# While alive, only our own child process group is ever killed. The
# orphan sweep kills only processes whose parent is gone (ppid 1) with
# their cwd in this repo — a job you started yourself in another
# terminal is waited on, never killed, for as long as its shell lives.
#
# The lock guards CORES, not just cargo: bench sweeps, upstream
# svelte-check comparisons, and standalone tsgo runs starve a test run
# exactly the way a second cargo does — the 10-minute suite this rule
# exists to prevent was last reproduced by a cargo test running
# concurrently with a 7000-file upstream comparison, no second cargo
# anywhere. `exec` routes any such heavy job through the same lock,
# process group, and cleanup.
#
# Usage:
#   scripts/ct test --workspace
#   scripts/ct clippy --workspace --all-targets -- -D warnings
#   scripts/ct build --release
#   scripts/ct exec node scripts/bench.mjs --target bench/foo
#   scripts/ct exec ./node_modules/.bin/svelte-check --tsgo
#
#   CT_WAIT=1 scripts/ct test      # wait for a live run instead of refusing
#   CT_TIMEOUT=900 scripts/ct test # give up waiting after N seconds

set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Outside target/ on purpose: `scripts/ct clean` must not delete the
# very lock that is serialising it.
lock_dir="${repo_root}/.ct.lock"
wait_for_lock="${CT_WAIT:-0}"
wait_timeout="${CT_TIMEOUT:-1800}"

if [ "$#" -eq 0 ]; then
    echo "usage: scripts/ct <cargo-subcommand> [args...] | scripts/ct exec <command> [args...]" >&2
    exit 2
fi

# `exec` mode: serialise an arbitrary heavy command under the same
# lock instead of a cargo subcommand.
exec_mode=0
if [ "$1" = "exec" ]; then
    exec_mode=1
    shift
    if [ "$#" -eq 0 ]; then
        echo "usage: scripts/ct exec <command> [args...]" >&2
        exit 2
    fi
fi

# The pid identity is (pid, start time): kill -0 alone would make a
# recycled pid look like a live owner forever.
proc_start() {
    ps -o lstart= -p "$1" 2>/dev/null
}

# `mkdir` is atomic on every filesystem we care about, so it is the
# lock; the pid identity goes inside it immediately after.
take_lock() {
    mkdir "$lock_dir" 2>/dev/null || return 1
    echo "$$" > "${lock_dir}/pid"
    proc_start "$$" > "${lock_dir}/start"
}

lock_age() {
    local mt now
    mt="$(stat -f %m "$lock_dir" 2>/dev/null || stat -c %Y "$lock_dir" 2>/dev/null)" || { echo 0; return; }
    now="$(date +%s)"
    echo $((now - mt))
}

# Is the recorded owner still running? A lock without a pid file yet is
# an owner mid-take_lock — treat it as live while the directory is
# young, stale only once it is old enough that the write can't still be
# in flight (a SIGKILL between mkdir and the pid write leaves exactly
# this shape behind). Same pid with a different start time is a
# recycled pid, i.e. a dead owner.
owner_alive() {
    local pid recorded current
    pid="$(cat "${lock_dir}/pid" 2>/dev/null)"
    if [ -z "$pid" ]; then
        [ "$(lock_age)" -lt 15 ]
        return
    fi
    kill -0 "$pid" 2>/dev/null || return 1
    recorded="$(cat "${lock_dir}/start" 2>/dev/null)"
    [ -z "$recorded" ] && return 0
    current="$(proc_start "$pid")"
    [ "$recorded" = "$current" ]
}

# Discard a dead owner's lock. The orphan sweep below already handles
# the dead run's PROCESSES (by parent-death, not by recorded pgid), so
# taking over is just removing the directory — rename it aside first so
# two racers can't each delete the other's freshly won lock.
reap_stale() {
    local claim="${lock_dir}.reap.$$"
    mv "$lock_dir" "$claim" 2>/dev/null || return 0
    rm -rf "$claim"
}

# Kill true orphans: heavy processes that have reparented to launchd
# (ppid 1 — their session is dead, nothing will ever reap them) and
# whose working directory is inside this repo. A live agent's build
# always has a live parent shell, so this can never take legitimate
# concurrent work. Killing a parent surfaces its children as new
# ppid-1 orphans, hence the passes.
reap_orphans() {
    local pass p ppid cwd killed
    for pass in 1 2 3; do
        killed=0
        for p in $(pgrep -x cargo 2>/dev/null; pgrep -x rustc 2>/dev/null;                    pgrep -x rustdoc 2>/dev/null; pgrep -x tsgo 2>/dev/null;                    pgrep -x svelte-check-native 2>/dev/null; pgrep -x svelte-check 2>/dev/null); do
            ppid="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
            [ "$ppid" = "1" ] || continue
            cwd="$(lsof -a -p "$p" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
            case "$cwd" in
                "$repo_root" | "$repo_root"/*) ;;
                *) continue ;;
            esac
            echo "ct: reaping orphaned process ${p} ($(ps -o comm= -p "$p" 2>/dev/null)) — its session is dead" >&2
            kill -TERM "$p" 2>/dev/null
            killed=1
        done
        [ "$killed" = "0" ] && break
        sleep 0.3
    done
}

# Heavy processes that did NOT come through ct: cargo, tsgo, or a
# svelte-check binary whose working directory is inside this repo,
# minus our own child group (the check runs before we spawn, so our
# own children cannot exist yet). These hold no lock, so they are
# waited on, never killed. Plain `node` is deliberately NOT matched:
# editor language servers park their cwd in the repo and would make
# this wait forever; a bench sweep's heavy children are the names
# above anyway.
foreign_heavy() {
    local p cwd
    for p in $(pgrep -x cargo 2>/dev/null; pgrep -x tsgo 2>/dev/null;                pgrep -x svelte-check-native 2>/dev/null; pgrep -x svelte-check 2>/dev/null); do
        cwd="$(lsof -a -p "$p" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
        case "$cwd" in
            "$repo_root" | "$repo_root"/*) echo "$p"; return 0 ;;
        esac
    done
    return 1
}

reap_orphans

waited=0
until take_lock; do
    if ! owner_alive; then
        reap_stale
        continue
    fi
    if [ "$wait_for_lock" != "1" ]; then
        echo "ct: another cargo run is active (pid $(cat "${lock_dir}/pid" 2>/dev/null))." >&2
        echo "ct: concurrent builds starve each other — 29s becomes ~570s." >&2
        echo "ct: wait for it, re-run with CT_WAIT=1, or kill it and retry." >&2
        exit 75    # EX_TEMPFAIL — a retry may succeed
    fi
    if [ "$waited" -ge "$wait_timeout" ]; then
        echo "ct: gave up waiting after ${wait_timeout}s for pid $(cat "${lock_dir}/pid" 2>/dev/null)" >&2
        exit 75
    fi
    [ "$waited" -eq 0 ] && echo "ct: waiting for the active cargo run to finish..." >&2
    sleep 2
    waited=$((waited + 2))
done

child_pgid=""
cleanup() {
    local status=$?
    trap - EXIT INT TERM HUP
    if [ -n "$child_pgid" ] && kill -0 "-${child_pgid}" 2>/dev/null; then
        kill -TERM "-${child_pgid}" 2>/dev/null
        for _ in 1 2 3 4 5; do
            kill -0 "-${child_pgid}" 2>/dev/null || break
            sleep 0.2
        done
        kill -KILL "-${child_pgid}" 2>/dev/null
    fi
    rm -rf "$lock_dir"
    exit "$status"
}
trap cleanup EXIT INT TERM HUP

# Lock held; now also wait out any hand-started heavy job working in
# this repo. It cannot be told to queue, so we are the ones who yield.
while pid="$(foreign_heavy)"; do
    if [ "$wait_for_lock" != "1" ]; then
        echo "ct: a heavy job started outside ct is running in this repo (pid ${pid})." >&2
        echo "ct: wait for it, re-run with CT_WAIT=1, or kill it and retry." >&2
        exit 75
    fi
    if [ "$waited" -ge "$wait_timeout" ]; then
        echo "ct: gave up waiting after ${waited}s for outside job (pid ${pid})" >&2
        exit 75
    fi
    [ "$waited" -eq 0 ] && echo "ct: waiting for an outside heavy job (pid ${pid}) to finish..." >&2
    sleep 2
    waited=$((waited + 2))
done

# Job control puts the child in its own process group, which is what
# makes `kill -- -PGID` reach cargo *and* every rustc it spawned.
set -m
if [ "$exec_mode" = "1" ]; then
    "$@" &
else
    "${CT_CARGO:-cargo}" "$@" &
fi
child_pid=$!
child_pgid="$child_pid"
set +m

wait "$child_pid"
exit $?
